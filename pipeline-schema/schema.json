{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeci.dev/schemas/pipeline/v1/schema.json",
  "title": "ForgeCI Pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pipeline"],
  "properties": {
    "version": {"const": 1},
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "jobs"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "triggers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": {"type": "integer", "minimum": 1, "maximum": 86400},
            "retries": {"type": "integer", "minimum": 0, "maximum": 10}
          }
        },
        "jobs": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "additionalProperties": {"$ref": "#/$defs/job"}
        }
      }
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "commands"],
      "properties": {
        "image": {"type": "string", "minLength": 1, "maxLength": 512},
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 8192}
        },
        "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "environment": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {"type": "string", "maxLength": 8192},
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        },
        "timeout": {"type": "integer", "minimum": 1, "maximum": 86400},
        "retries": {"type": "integer", "minimum": 0, "maximum": 10},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1}}
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": {
            "key": {"type": "string", "minLength": 1, "maxLength": 256},
            "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "working_directory": {"type": "string", "minLength": 1}
      }
    }
  }
}